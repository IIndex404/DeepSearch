# Copy to backend/.env; supply your own credentials.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_API_KEY=
TAVILY_API_KEY=

# Business database for the SQL assistant; use a read-only account.
# This is separate from RAGFlow's internal metadata database.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=deepsearch_readonly
MYSQL_PASSWORD=
MYSQL_DATABASE=your_business_database

RAGFLOW_BASE_URL=http://127.0.0.1:9380
RAGFLOW_API_KEY=
